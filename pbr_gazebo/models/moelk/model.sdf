<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='moelk'>
    <static>true</static>
      <link name="moelk_link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="moelk_collision">
          <geometry>
            <mesh>
              <uri>model://pbr_gazebo/models/moelk/meshes/pbr_robot_lab.stl</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="moelk_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://pbr_gazebo/models/moelk/meshes/pbr_robot_lab.stl</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
          <material> <!-- Gazebo/Grey -->
            <ambient>1 1 1 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
  </model>
</sdf>
