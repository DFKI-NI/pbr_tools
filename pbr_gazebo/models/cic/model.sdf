            <mesh>
              <uri>model://pbr_gazebo/models/cic/meshes/pbr_cic.stl</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
          <material> <!-- Gazebo/Grey -->
            <ambient>1 1 1 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
