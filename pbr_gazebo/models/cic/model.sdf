          <geometry>
            <mesh>
              <uri>model://pbr_gazebo/models/cic/meshes/pbr_cic.stl</uri>
              <scale>1.0 1.0 1.0</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="pbr_cic_visual">
          <cast_shadows>false</cast_shadows>
