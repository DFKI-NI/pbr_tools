<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pbr_cic">

    <!-- A global light source -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <!-- Turn off the built-in grid -->
    <scene>
      <grid>false</grid>
    </scene>

    <include>
      <uri>model://pbr_gazebo/models/cic</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
